/Type /StructElem
/S /H1
/T (SELECT c.gender,         COUNT\(rc.ride_id\) / \(SELECT COUNT\(*\) FROM Rides\) * 100 AS cancellation_rate FROM Ride_Cancel as  rc JOIN Customers as c ON rc.customer_id = c.customer_id GROUP BY c.gender; )
